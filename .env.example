# Copy this file to .env and fill in your values
# NEVER commit .env to GitHub

# Database — provided by Railway automatically
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Session secret — use any long random string
SESSION_SECRET=change-this-to-a-long-random-string-minimum-32-chars

# Admin login credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# Port (Railway sets this automatically)
PORT=3000

# Property info
PROPERTY_NAME=Latika Residence
PROPERTY_ADDRESS=3 Monkeys Road 17252 Siem Reap
PROPERTY_PHONE=+855 972 304 710
PROPERTY_TIN=E116-2600001351
PROPERTY_CURRENCY=$
